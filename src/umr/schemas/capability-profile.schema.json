{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umr:schema:capability-profile:v0.1",
  "title": "Universal Model Router Capability Profile v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "source",
    "capabilities",
    "deployments",
    "evaluations",
    "quality_evidence_level",
    "trust"
  ],
  "properties": {
    "schema_version": {"const": "umr/v0.1"},
    "id": {"type": "string", "minLength": 3},
    "kind": {"enum": ["model", "tool", "application", "workflow"]},
    "display_name": {"type": "string"},
    "description": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["publisher", "artifact_url"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "artifact_url": {"type": "string", "format": "uri"},
        "artifact_id": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "artifact_digest": {"type": ["string", "null"]},
        "license": {
          "type": "object",
          "properties": {
            "code": {"type": ["string", "null"]},
            "weights": {"type": ["string", "null"]},
            "data": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "input_schema", "output_schema"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"},
          "applicability": {
            "type": "object",
            "properties": {
              "geography": {"type": "string"},
              "regions": {"type": "array", "items": {"type": "string"}},
              "min_horizon_days": {"type": "number", "minimum": 0},
              "max_horizon_days": {"type": "number", "minimum": 0},
              "native_temporal_resolution_hours": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": true
          },
          "data_requirements": {"type": "array", "items": {"type": "string"}},
          "preprocessing": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["hosted_api", "gradio", "mcp", "local"]},
          "adapter": {"type": "string"},
          "endpoint_ref": {"type": ["string", "null"]},
          "status": {"enum": ["ready", "degraded", "offline", "unknown"]},
          "auth_scopes": {"type": "array", "items": {"type": "string"}},
          "resource_requirements": {
            "type": "object",
            "properties": {
              "minimum_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
              "accelerators": {"type": "array", "items": {"type": "string"}},
              "runtime": {"type": ["string", "null"]},
              "network_egress": {"type": ["boolean", "null"]}
            },
            "additionalProperties": true
          },
          "cost": {
            "type": ["object", "null"],
            "properties": {
              "currency": {"type": ["string", "null"]},
              "amount": {"type": ["number", "null"], "minimum": 0},
              "unit": {"type": ["string", "null"]},
              "status": {"type": "string"}
            },
            "additionalProperties": true
          },
          "latency_ms": {"type": ["number", "null"], "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_level"],
        "properties": {
          "benchmark": {"type": ["string", "null"]},
          "dataset_revision": {"type": ["string", "null"]},
          "task_id": {"type": ["string", "null"]},
          "region": {"type": ["string", "null"]},
          "horizon": {"type": ["string", "number", "null"]},
          "horizon_days": {"type": ["number", "null"], "minimum": 0},
          "metric": {"type": ["string", "null"]},
          "value": {"type": ["number", "null"]},
          "evaluated_at": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "artifact": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "revision": {"type": ["string", "null"]},
              "digest": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"}
            },
            "anyOf": [{"required": ["revision"]}, {"required": ["digest"]}],
            "additionalProperties": false
          },
          "contract_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
          "dataset": {
            "type": "object",
            "required": ["id", "revision", "split", "config_digest"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1},
              "split": {"type": "string", "minLength": 1},
              "config_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}
            },
            "additionalProperties": true
          },
          "applicability": {
            "type": "object",
            "properties": {
              "region": {"type": ["string", "null"]},
              "horizon_days": {"type": ["number", "null"], "minimum": 0},
              "resolution": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "value", "unit", "direction"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "value": {"type": "number"},
                "unit": {"type": "string", "minLength": 1},
                "direction": {"enum": ["lower", "higher"]},
                "sample_count": {"type": ["integer", "null"], "minimum": 0},
                "standard_error": {"type": ["number", "null"], "minimum": 0},
                "confidence_interval": {
                  "type": ["array", "null"],
                  "prefixItems": [{"type": "number"}, {"type": "number"}],
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "additionalProperties": true
            }
          },
          "source": {
            "type": "object",
            "required": ["url", "evaluator"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "evaluator": {"type": "string", "minLength": 1},
              "evidence_level": {"enum": ["publisher_claim", "reproduced", "independent"]},
              "access_license": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          },
          "verified_by": {"type": ["string", "null"]},
          "evidence_level": {
            "enum": ["none", "publisher_claim", "reproduced", "independent"]
          }
        },
        "allOf": [
          {
            "if": {"required": ["artifact"]},
            "then": {"required": ["task_id", "contract_digest", "dataset", "applicability", "metrics", "source"]}
          }
        ],
        "additionalProperties": true
      }
    },
    "quality_evidence_level": {
      "enum": ["none", "publisher_claim", "reproduced", "independent"]
    },
    "runtime_status": {
      "type": "object",
      "properties": {
        "status": {"enum": ["ready", "degraded", "offline", "unknown"]},
        "last_probe": {"type": ["string", "null"], "format": "date-time"},
        "latency_ms": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "trust": {"type": "object"},
    "discovery_status": {"type": "string"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
